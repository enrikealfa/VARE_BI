@model List<SSF.PortalBI.DTOs.UsuarioDto>
@{ ViewData["Title"] = "Usuarios"; }

<h2>Usuarios del Portal</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">Nuevo usuario</a>

<table class="table table-striped">
    <thead>
        <tr><th>Usuario</th><th>Correo</th><th>Nombre completo</th><th>Roles</th><th>Estado</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.NombreUsuario</td>
                <td>@u.Correo</td>
                <td>@u.NombreCompleto</td>
                <td>@string.Join(", ", u.Roles)</td>
                <td>
                    @if (u.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                    @if (u.Bloqueado)
                    {
                        <span class="badge bg-danger">Bloqueado</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@u.IdUsuario" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                        <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                        <input type="hidden" name="activo" value="@((!u.Activo).ToString())" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(u.Activo ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>