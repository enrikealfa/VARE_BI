@model SSF.PortalBI.DTOs.UsuarioEditDto
@{ ViewData["Title"] = "Editar usuario"; }

<h2>Editar usuario: @Model.NombreUsuario</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdUsuario" />
    <input type="hidden" asp-for="NombreUsuario" />

    <div class="mb-3">
        <label class="form-label">Usuario</label>
        <input class="form-control" value="@Model.NombreUsuario" disabled />
    </div>
    <div class="mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NombreCompleto" class="form-label"></label>
        <input asp-for="NombreCompleto" class="form-control" />
        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NuevaClave" class="form-label"></label>
        <input asp-for="NuevaClave" type="password" class="form-control" />
        <span asp-validation-for="NuevaClave" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label"></label>
    </div>
    <div class="mb-3">
        <label class="form-label">Roles</label>
        @for (int i = 0; i < Model.RolesDisponibles.Count; i++)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="RolesSeleccionados" value="@Model.RolesDisponibles[i].IdRol"
                       id="rol_@Model.RolesDisponibles[i].IdRol" checked="@Model.RolesDisponibles[i].Seleccionado" />
                <label class="form-check-label" for="rol_@Model.RolesDisponibles[i].IdRol">@Model.RolesDisponibles[i].NombreRol</label>
            </div>
        }
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>